# Client-side (safe to expose — Supabase's anon key is public by design,
# access is controlled via RLS policies, not key secrecy)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — NEVER prefix this with EXPO_PUBLIC_, or Expo will bundle it
# into client code. Used by the Supabase Edge Function that calls Gemini (Phase 4);
# not consumed by the app directly.
GEMINI_API_KEY=
